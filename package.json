    "db:seed": "npx tsx prisma/seed.ts",
    "test": "npx tsx tests/platform.test.ts",
    "postinstall": "node scripts/prepare-db.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
