# Industrias CIN - Variables de Entorno
# Base de datos: SQLite para ejecución local sin configuración externa.
# Para PostgreSQL (Supabase), reemplace por: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL="file:./dev.db"

# JWT Secret para sesiones y autenticación RBAC
JWT_SECRET="cin-industrias-super-secure-jwt-key-2026-production"

# Configuración de Empresa
NEXT_PUBLIC_APP_NAME="Industrias CIN"
NEXT_PUBLIC_APP_TAGLINE="Bebidas No Carbonatadas (Hervidos y Jugos)"
